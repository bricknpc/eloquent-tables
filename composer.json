{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "bricknpc/eloquent-tables",
  "type": "library",
  "description": "Eloquent tables for Laravel.",
  "keywords": [
    "Eloquent",
    "Table",
    "DataTable",
    "Laravel",
    "Pagination",
    "Filtering",
    "Sorting"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4|^8.5",
    "ext-intl": "*",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/cookie": "^12.0|^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.3",
    "orchestra/testbench": "^10.6|^11.0",
    "carthage-software/mago": "^1.47"
  },
  "autoload": {
    "psr-4": {
      "BrickNPC\\EloquentTables\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "BrickNPC\\EloquentTables\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "mago:format": "php vendor/bin/mago format",
    "mago:format:check": "php vendor/bin/mago format --dry-run",
    "mago:lint": "php vendor/bin/mago lint",
    "mago:analyze": "php vendor/bin/mago analyze",
    "cs": "@mago:format",
    "ps": "@mago:analyze",
    "c": [
      "@mago:format",
      "@mago:analyze"
    ],
    "test": "php vendor/bin/phpunit -c phpunit.xml --colors=always --coverage-html tests/coverage/html"
  },
  "extra": {
    "laravel": {
      "providers": [
        "BrickNPC\\EloquentTables\\Providers\\EloquentTablesServiceProvider"
      ]
    }
  }
}
